# Prisma Accelerate (para queries)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# Conexión directa (para migraciones)
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Registration
REGISTRATION_ENABLED="false"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@domain.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Your App Name <your-email@domain.com>"
# Opcional: "true" fuerza TLS directo; por defecto se usa solo con el puerto 465 (587 usa STARTTLS)
SMTP_SECURE=""

# Opcional: URL pública usada en el botón "Ver orden de servicio" de los correos.
# Si no se define se usa NEXTAUTH_URL. Debe ser accesible para los clientes (no una IP de la red local).
APP_PUBLIC_URL=""

# Opcional: carpeta donde se guardan los adjuntos (por defecto storage/uploads, fuera de public).
# Debe ser persistente entre despliegues; en Vercel usa un almacenamiento externo.
UPLOAD_DIR=""

# Opcional: "true" permite /api/seed/tickets (datos de prueba) también en producción. Déjalo vacío.
ALLOW_TICKET_SEED=""
