// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users     User[]
  tickets   Ticket[]
}

enum UserRole {
  ADMIN
  AGENT
  CUSTOMER
  ACCOUNTING
}

model User {
  id                 String       @id @default(cuid())
  email              String?      @unique
  name               String?
  password           String?
  avatar             String?
  // Monthly targets; legacy column names retained to preserve configured values.
  dailyEntryGoal     Int?
  dailyClosureGoal   Int?
  role               UserRole     @default(CUSTOMER)
  phone              String?
  location           String?
  address            String?
  publicToken        String?      @unique
  emailNotifications Boolean      @default(true)
  // Inactive users cannot sign in and are hidden from scheduling and assignment; data is kept.
  active             Boolean      @default(true)
  twoFactorEnabled   Boolean      @default(false)
  twoFactorSecret    String?
  // Job title printed under the signature of staff documents (quotes).
  jobTitle           String?
  // Billing identity of customers: legal name and NIT / cedula are optional.
  businessName       String?
  taxId              String?
  // First billing account number for this customer; applies until the sequence starts.
  billingStartNumber Int          @default(1)
  organizationId     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  
  organization      Organization?  @relation(fields: [organizationId], references: [id])
  assignedTickets   Ticket[]       @relation("AssignedTickets")
  ticketAssignments TicketAssignee[]
  createdTickets    Ticket[]       @relation("CreatedTickets")
  messages          Message[]
  interactions      Interaction[]
  serviceClients    ServiceRecord[] @relation("ServiceClient")
  serviceAssigned   ServiceRecord[] @relation("ServiceTechnician")
  quotes            Quote[]          @relation("QuoteCustomer")
  loansAsCustomer   EquipmentLoan[]  @relation("LoanCustomer")
  loansAsTechnician EquipmentLoan[]  @relation("LoanTechnician")
  billingAccounts   BillingAccount[] @relation("BillingCustomer")
  billingTemplates  BillingTemplate[] @relation("BillingTemplateCustomer")
  billingSequence   CustomerBillingSequence?
  @@index([role])
}

enum TicketStatus {
  OPEN
  PENDING
  SOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketType {
  INCIDENT
  CHANGE_REQUEST
  PROJECT
}

model Ticket {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  subject        String
  description    String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  type           TicketType?
  hours          Float?
  tags           String[]
  attachments    String[]
  customerId     String
  assigneeId     String?
  categoryId     String?
  organizationId String?
  enteredById    String?
  closedById     String?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  customer       User           @relation("CreatedTickets", fields: [customerId], references: [id])
  assignee       User?          @relation("AssignedTickets", fields: [assigneeId], references: [id])
  category       Category?      @relation(fields: [categoryId], references: [id])
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  messages       Message[]
  assignments    TicketAssignee[]
  interactions   Interaction[]
  @@index([status, updatedAt])
  @@index([customerId, status, updatedAt])
  @@index([assigneeId])
  @@index([enteredById, createdAt])
  @@index([closedById, closedAt])
}

model TicketAssignee {
  ticketId String
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User   @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@id([ticketId, userId])
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

enum MessageType {
  COMMENT
  NOTE
  EMAIL
  WHATSAPP
  SYSTEM
}

model Message {
  id         String      @id @default(cuid())
  content    String
  type       MessageType @default(COMMENT)
  isInternal Boolean     @default(false)
  ticketId   String
  authorId   String
  attachments String[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  
  ticket     Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User        @relation(fields: [authorId], references: [id])
  @@index([ticketId])
}

enum InteractionType {
  CONVERSATION
  EMAIL_CHANGE
  ORDER
  ARTICLE_VIEW
  RECEIPT
}

model Interaction {
  id          String          @id @default(cuid())
  type        InteractionType
  title       String
  description String?
  metadata    Json?
  userId      String
  ticketId    String?
  createdAt   DateTime        @default(now())
  
  user        User            @relation(fields: [userId], references: [id])
  ticket      Ticket?         @relation(fields: [ticketId], references: [id])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payload preserves template versions, response snapshots and signed documents.
model ServiceRecord {
  id          String   @id
  kind        String
  clientId    String?
  techId      String?
  revision    Int      @default(1)
  orderNumber Int?     @unique
  previousNumber String?
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      User?    @relation("ServiceClient", fields: [clientId], references: [id])
  technician  User?    @relation("ServiceTechnician", fields: [techId], references: [id])

  @@index([kind, techId])
  @@index([kind, updatedAt])
  @@index([clientId])
}

model ServiceCounter {
  key   String @id
  value Int
}

model ServiceAuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  entityId  String
  action    String
  createdAt DateTime @default(now())
  @@index([entityId])
}

// ---------------------------------------------------------------------------
// Accounting: quote catalog, quotes and billing accounts (cuentas de cobro).
// Documents keep snapshots of the customer, company, products and taxes they used,
// so later catalog edits never change what was issued.
// ---------------------------------------------------------------------------

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  // Suggested unit price; editable per quote line without touching the catalog.
  price       Decimal     @db.Decimal(14, 2)
  active      Boolean     @default(true)
  // Inventory on hand (units). Every change goes through an InventoryMovement.
  stock       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quoteItems  QuoteItem[]
  movements   InventoryMovement[]
  loans       EquipmentLoan[]

  @@index([active, name])
}

// ---------------------------------------------------------------------------
// Inventory: stock movements (kardex) and equipment loans to customers.
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  PURCHASE
  ENTRY
  WRITE_OFF
  COUNT
  LOAN_OUT
  LOAN_IN
}

model InventoryMovement {
  id              String                @id @default(cuid())
  productId       String
  product         Product               @relation(fields: [productId], references: [id])
  type            InventoryMovementType
  // Signed change applied to the stock (counts store the adjustment).
  quantity        Int
  balanceAfter    Int
  unitCost        Decimal?              @db.Decimal(14, 2)
  reference       String?
  notes           String?
  // Physical count: units found.
  countedQuantity Int?
  loanId          String?
  loan            EquipmentLoan?        @relation(fields: [loanId], references: [id])
  createdById     String?
  createdAt       DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([loanId])
}

enum LoanStatus {
  OUT
  RETURNED
}

// Equipment lent to a customer under a technician's responsibility, with photos at exit and return.
model EquipmentLoan {
  id            String              @id @default(cuid())
  number        Int                 @unique @default(autoincrement())
  productId     String
  product       Product             @relation(fields: [productId], references: [id])
  quantity      Int                 @default(1)
  customerId    String
  customer      User                @relation("LoanCustomer", fields: [customerId], references: [id])
  technicianId  String
  technician    User                @relation("LoanTechnician", fields: [technicianId], references: [id])
  status        LoanStatus          @default(OUT)
  outAt         DateTime            @default(now())
  outNotes      String?
  outPhotos     String[]
  returnedAt    DateTime?
  returnNotes   String?
  returnPhotos  String[]
  returnedById  String?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     InventoryMovement[]

  @@index([status, outAt])
  @@index([productId, status])
  @@index([customerId])
  @@index([technicianId])
}

model Tax {
  id        String   @id @default(cuid())
  name      String
  // Percentage, e.g. 19.00 for IVA 19 %.
  rate      Decimal  @db.Decimal(7, 4)
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes    Quote[]

  @@index([active])
}

model Quote {
  id               String      @id @default(cuid())
  number           Int         @unique @default(autoincrement())
  // Null when the quote was issued to a customer that is not registered (free-text name).
  customerId       String?
  customer         User?       @relation("QuoteCustomer", fields: [customerId], references: [id])
  // Customer and company data as they were when the quote was issued.
  customerSnapshot Json
  companySnapshot  Json
  taxId            String?
  tax              Tax?        @relation(fields: [taxId], references: [id])
  taxName          String?
  taxRate          Decimal?    @db.Decimal(7, 4)
  subtotal         Decimal     @db.Decimal(14, 2)
  taxAmount        Decimal     @db.Decimal(14, 2)
  total            Decimal     @db.Decimal(14, 2)
  title            String      @default("Cotización")
  notes            String?
  conditions       String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            QuoteItem[]

  @@index([customerId, createdAt])
  @@index([createdAt])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  position    Int
  // Snapshot of the product at quote time.
  name        String
  description String?
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)

  @@index([quoteId])
  @@index([productId])
}

enum BillingFrequency {
  MONTHLY
}

enum BillingAccountStatus {
  ISSUED
  VOID
}

// Recurring billing configuration. It never consumes numbers: only generated accounts do.
model BillingTemplate {
  id          String           @id @default(cuid())
  customerId  String
  customer    User             @relation("BillingTemplateCustomer", fields: [customerId], references: [id])
  concept     String
  total       Decimal          @db.Decimal(14, 2)
  frequency   BillingFrequency @default(MONTHLY)
  active      Boolean          @default(true)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  accounts    BillingAccount[]

  @@index([customerId])
  @@index([active, customerId])
}

// One issued cuenta de cobro. `number` is the customer's own consecutive (01, 02, ...).
model BillingAccount {
  id            String               @id @default(cuid())
  customerId    String
  customer      User                 @relation("BillingCustomer", fields: [customerId], references: [id])
  number        Int
  templateId    String?
  template      BillingTemplate?     @relation(fields: [templateId], references: [id])
  // Billing period of recurring accounts (YYYY-MM); one account per template and period.
  period        String?
  concept       String
  total         Decimal              @db.Decimal(14, 2)
  // Everything the document shows (customer, company, amount in words, dates).
  snapshot      Json
  status        BillingAccountStatus @default(ISSUED)
  publicToken   String               @unique
  publicEnabled Boolean              @default(true)
  // PDF generated at issue time; the download, the email and the public link serve it.
  pdf           Bytes?
  issuedAt      DateTime             @default(now())
  dueAt         DateTime?
  voidedAt      DateTime?
  voidReason    String?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([customerId, number])
  @@unique([templateId, period])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([status])
}

// Per-customer consecutive. Updated with a single UPSERT inside the issuing transaction,
// so simultaneous requests for one customer serialize on this row and never share a number.
model CustomerBillingSequence {
  customerId String @id
  customer   User   @relation(fields: [customerId], references: [id])
  lastNumber Int
}
